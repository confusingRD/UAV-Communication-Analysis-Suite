# Local Python runtimes and dependency caches
/.python/
/.uv-cache/
/.venv/
/.venv-science/
.venv*/

# Python bytecode, test, analysis, and coverage caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging and frozen-application products
*.egg-info/
/build/
/dist/
/.smoke/

# Local IDE and operating-system state
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Credentials and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json

# Temporary files and non-reproducible intermediate simulations
*.bak
*.log
*.tmp
*.temp
*~
/tmp/
/temp/
/scratch/
/outputs/tmp/
/outputs/intermediate/
/simulations/tmp/
/simulations/intermediate/

# Private local engineering history and generated reporting artifacts
docs/
CommZipFile/
/outputs/reporting/

# Unrelated local backup archives and extracted backup folders
*.zip
/zip/

